{
  "expo": {
    "name": "C-Track",
    "slug": "ctrack",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/c-track-icon.png",
    "scheme": "ctrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to track task progress and record your position during work.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location even when in the background to automatically track your position every 5 minutes during active tasks.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to track task progress continuously.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.lifemedia.trackingapp",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/c-track-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/c-track-icon.png",
        "backgroundColor": "#130028"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/c-track-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to track your location during tasks.",
          "locationAlwaysPermission": "Allow this app to track your location even when the app is in the background.",
          "locationWhenInUsePermission": "Allow this app to track your location while using the app.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/C-Track.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#130028",
          "dark": {
            "backgroundColor": "#130028"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 31
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe887f3d-362c-47f1-9b2b-1b0775937a32"
      }
    },
    "owner": "wijayayaya",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0cb4a2f1-b18f-4fa5-ba4f-11e526eff45b"
    }
  }
}
