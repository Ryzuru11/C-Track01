# Database
DATABASE_URL="mysql://root:password@localhost:3306/trackingapp?timezone=Z"
# Realtime production DB (direct connection example):
# DATABASE_URL="mysql://ctrack:<password>@202.169.232.241:3306/cleon_tracking?timezone=Z"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=8000
NODE_ENV=development
TZ=Asia/Jakarta

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI Providers (DeepSeek + Groq Llama3)
DEEPSEEK_API_KEY="your-deepseek-api-key"
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"
AI_DAILY_REQUEST_LIMIT="350"
